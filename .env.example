# Change these before using outside local development.
# For local work run the API in Development (dotnet run does this via launchSettings;
# docker compose defaults to Production, so set ASPNETCORE_ENVIRONMENT=Development here).
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_PASSWORD=change-this-db-password
BOOTSTRAP_ADMIN_EMAIL=admin@anaquranacademy.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123

# OTP delivery. Leave OTP_DEV_MODE=true for local work (code 8888, no SMS sent).
# For real SMS, set OTP_DEV_MODE=false and OTP_SENDER=textbee. See https://textbee.dev.
OTP_DEV_MODE=true
OTP_SENDER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Contact form delivery. The receiver is fixed on the server; the public form
# never chooses the destination. Use an app password, not your main password.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
CONTACT_RECEIVER_EMAIL=

# Browser notifications (Web Push). Generate a VAPID key pair once, e.g.
#   npx web-push generate-vapid-keys
# The public half is handed to the browser by GET /api/web-push/key; the private
# half signs every message and never leaves this server. Leave both blank to
# keep browser subscriptions off — mobile push and the in-app feed are unaffected.
# docker compose maps these below; on a host without compose set the same three
# under their .NET names instead: WebPush__PublicKey, WebPush__PrivateKey,
# WebPush__Subject.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@anaquran.com

# Live lesson room features, all off until set to true. Clients refresh every
# 30 seconds; Jitsi toolbar switches still apply only to newly opened rooms.
LessonRoom__Whiteboard=false
LessonRoom__Chat=false
LessonRoom__CameraBackground=false
LessonRoom__Pen=false
LessonRoom__PerformanceSettings=false
LessonRoom__Transcription=false
LessonRoom__ReportConcern=false
# Set to the UTC rollout instant only when capture is approved. Blank means no
# coverage expectations; text expires after a fixed 30 days regardless of flags.
Transcripts__LightCaptureSince=

# Minimum notice, in minutes, a student must give a teacher when moving a
# weekly lesson to one of their published times. Times whose next class starts
# sooner than this are neither offered nor accepted. 0 removes the rule.
Scheduling__TimeChangeLeadMinutes=60

# Who may name the client's real address. The web app reaches the API through a
# same-origin proxy, so without this every browser shares one rate-limit bucket
# and the audit log records the proxy instead of the user. List the proxy's
# egress IPs (comma-separated, single addresses only) and leave blank locally.
# On a direct host (mobile, curl) the peer address is already correct, so blank
# is the safe setting: an unlisted peer cannot claim an address in X-Forwarded-For.
Forwarding__TrustedProxies=
# Optional. Only needed to trust X-Forwarded-Host, which names the public origin
# the browser is told to use for realtime. Leave blank and set Realtime__PublicUrl.
Forwarding__AllowedHosts=

# The origin the browser should dial for the SignalR hub. Set it in every hosted
# environment; when blank the app falls back to the request's own host, and a
# proxied request's host is the frontend's, not the API's.
Realtime__PublicUrl=

# Observability. Leave blank to disable. Sentry only reports when
# ASPNETCORE_ENVIRONMENT=Production; OTLP export only runs when the endpoint is set.
# Create this project in the ana-quran-academy org as: ana-quran-academy-api
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=academy-api
