# Change these before using outside local development.
# For local work run the API in Development (dotnet run does this via launchSettings;
# docker compose defaults to Production, so set ASPNETCORE_ENVIRONMENT=Development here).
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_PASSWORD=change-this-db-password
BOOTSTRAP_ADMIN_EMAIL=admin@anaquranacademy.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123

# OTP delivery. Leave OTP_DEV_MODE=true for local work (code 8888, no SMS sent).
# For real SMS, set OTP_DEV_MODE=false and OTP_SENDER=textbee. See https://textbee.dev.
OTP_DEV_MODE=true
OTP_SENDER=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Contact form delivery. The receiver is fixed on the server; the public form
# never chooses the destination. Use an app password, not your main password.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
CONTACT_RECEIVER_EMAIL=

# Browser notifications (Web Push). Generate a VAPID key pair once, e.g.
#   npx web-push generate-vapid-keys
# The public half is handed to the browser by GET /api/web-push/key; the private
# half signs every message and never leaves this server. Leave both blank to
# keep browser subscriptions off — mobile push and the in-app feed are unaffected.
# docker compose maps these below; on a host without compose set the same three
# under their .NET names instead: WebPush__PublicKey, WebPush__PrivateKey,
# WebPush__Subject.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@anaquran.com

# Observability. Leave blank to disable. Sentry only reports when
# ASPNETCORE_ENVIRONMENT=Production; OTLP export only runs when the endpoint is set.
# Create this project in the ana-quran-academy org as: ana-quran-academy-api
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=academy-api
